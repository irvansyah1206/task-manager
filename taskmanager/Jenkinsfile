pipeline {
    agent any
    stages {
        stage('Compile & Unit Test') {
            agent {
                docker { image 'maven:3.9-eclipse-temurin-17' }
            }
            steps {
                sh 'mvn clean test'
            }
        }
        stage('Docker Build') {
            steps {
                // Diubah: Perintah docker build biasanya menggunakan '.' (titik)
                // untuk konteks folder saat ini, bukan '.mvn'
                sh 'docker build -t irvansyah/taskmanager:${BUILD_NUMBER} .'
            }
        }
        stage('Security Scan') {
            steps {
                echo "Scanning for vulnerabilities..."
            }
        }
    }
    post {
        failure {
            echo "Pipeline gagal! Segera perbaiki unit test atau build."
        }
    }
}